{
  "functions": {
    "api/shopifyFix.js":    { "maxDuration": 60  },
    "api/shopifySync.ts":   { "maxDuration": 300 },
    "api/walmart-sync.ts":  { "maxDuration": 300 },
    "api/order-router.ts":  { "maxDuration": 60  },
    "api/authorize-order.ts": { "maxDuration": 30 }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/shopifySync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/walmart-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/feed/gmc",
      "schedule": "0 */6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
