{
  "functions": {
    "api/shopifyFix.js": {
      "maxDuration": 60
    },
    "api/shopifySync.ts": {
      "maxDuration": 300
    },
    "api/tagOos.ts": {
      "maxDuration": 300
    },
    "api/notifyMe.ts": {
      "maxDuration": 15
    },
    "api/installer-outreach.ts": {
      "maxDuration": 120
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/shopifySync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/feed/gmc",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/tagOos",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/fixTireSize?autorun=true",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/installer-outreach?action=run",
      "schedule": "0 13 * * 5"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}