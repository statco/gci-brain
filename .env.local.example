# ── AIRTABLE (server-side only — never use VITE_ prefix) ──
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_INSTALLERS_TABLE=Installers
AIRTABLE_JOBS_TABLE=Installation Jobs
AIRTABLE_PAYMENTS_TABLE=Installer Payments
AIRTABLE_NOTIFICATIONS_TABLE=Notifications

# ── SHOPIFY (server-side) ──────────────────────────────────
SHOPIFY_STORE_DOMAIN=gcitires.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_WEBHOOK_SECRET — copy from Shopify Admin → Settings → Notifications → Webhooks
# after creating the orders/paid webhook pointing to https://<your-vercel-domain>/api/order-router
SHOPIFY_WEBHOOK_SECRET=

# ── ORDER ROUTER ──────────────────────────────────────────
# Random 32+ character string — used to sign "Authorize Payment" links.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_ROUTER_SECRET=

# Base URL for authorize links (auto-detected from VERCEL_URL in production)
# Set this locally for testing: http://localhost:3000
APP_BASE_URL=

# ── NOTIFICATIONS ─────────────────────────────────────────
# Telegram bot (recommended — real-time mobile alerts)
#   1. Message @BotFather on Telegram to create a bot → get TELEGRAM_BOT_TOKEN
#   2. Message your bot, then visit https://api.telegram.org/bot<token>/getUpdates → get chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email notifications via Resend (already used for order confirmation emails)
RESEND_API_KEY=                          # existing — reused here
NOTIFY_EMAIL_TO=owner@gcitires.com       # your email address for order alerts
NOTIFY_EMAIL_FROM=GCI Orders <orders@updates.gcitires.ca>

# ── CJ DROPSHIPPING (Nuproz orders) ─────────────────────
# Option A: API Key (preferred — doesn't expire)
CJ_API_KEY=
# Option B: Email + Password (auto-refreshes token)
CJ_EMAIL=
CJ_PASSWORD=

# ── WALMART MARKETPLACE ───────────────────────────────────
# Get from: https://developer.walmart.com → My Account → Credentials
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
# For Walmart Canada use the same base URL (differentiated by credentials)
WALMART_BASE_URL=https://marketplace.walmartapis.com

# ── CANADA TIRE (existing sync) ────────────────────────────
CT_CONSUMER_KEY=
CT_CONSUMER_SECRET=
CT_TOKEN_ID=
CT_TOKEN_SECRET=
CT_CUSTOMER_NUMBER=19997
CT_CUSTOMER_API_TOKEN=
CT_USE_SANDBOX=true
